---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CategoryCard from "../../components/CategoryCard.astro";
import { getCategoryCatalog } from "../../data/games";

const categories = getCategoryCatalog();
---
<BaseLayout
  title="Game Categories - GamesBrowse"
  description="Browse arcade, puzzle, racing, reflex, clicker, sports, shooting, and casual browser game categories on GamesBrowse."
  canonicalPath="/category/"
>
  <section class="page-section">
    <div class="container stack">
      <div class="hero-panel stack">
        <div class="breadcrumbs">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <span>Categories</span>
        </div>
        <span class="eyebrow">Categories</span>
        <h1>Browse Game Categories</h1>
        <p class="lead">
          Explore the GamesBrowse catalog by style, from quick arcade runs and racing demos to calm
          puzzles and casual browser games.
        </p>
      </div>

      <div class="category-grid">
        {categories.map((category) => <CategoryCard category={category} />)}
      </div>
    </div>
  </section>
</BaseLayout>
