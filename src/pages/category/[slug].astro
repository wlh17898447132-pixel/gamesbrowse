---
import CategoryPage from "../../components/CategoryPage.astro";
import { getCategoryCatalog, getGamesByCategory } from "../../data/games";

export function getStaticPaths() {
  return getCategoryCatalog().map((category) => ({
    params: { slug: category.slug },
    props: {
      category,
      games: getGamesByCategory(category.slug)
    }
  }));
}

const { category, games } = Astro.props;
const title = `${category.label} Games - Play Free Online | GamesBrowse`;
const description = `Play free ${category.label.toLowerCase()} games online on GamesBrowse. Browse free browser games and start playing instantly.`;
const noindex = !category.indexable;
---
<CategoryPage
  category={category}
  games={games}
  title={title}
  description={description}
  canonicalPath={`/category/${category.slug}/`}
  noindex={noindex}
/>
