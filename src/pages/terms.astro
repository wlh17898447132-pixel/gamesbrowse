---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Terms of Use | Chaos Front Guide"
  description="Terms for using the Chaos Front Guide website."
  canonicalPath="/terms/"
  noindex={true}
>
  <section class="page-section">
    <div class="container">
      <div class="article-copy legal-copy">
        <span class="eyebrow">Terms</span>
        <h1>Terms of Use</h1>
        <p class="muted">Last updated: August 14, 2026</p>

        <h2>Informational use</h2>
        <p>
          Chaos Front Guide provides editorial information. It is not affiliated with the game's
          developer, publisher, Steam, or Valve. Game details can change between builds; readers
          should confirm important choices in their own current game version.
        </p>

        <h2>Content use</h2>
        <p>
          Site text and original captures may not be republished as a competing archive without
          permission. Game names, marks, and third-party materials remain the property of their
          respective owners.
        </p>

        <h2>External links</h2>
        <p>
          Links to official game pages are provided for convenience. External sites have their own
          terms and privacy practices.
        </p>

        <h2>Updates</h2>
        <p>
          These terms may change as the site adds verified guides or site features. Continued use
          after a posted update indicates acceptance of the revised terms.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
