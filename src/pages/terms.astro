---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Terms of Use | GamesBrowse"
  description="Terms placeholder for GamesBrowse during the multi-page migration."
  canonicalPath="/terms/"
>
  <section class="page-section">
    <div class="container">
      <div class="panel legal-copy">
        <span class="eyebrow">Terms</span>
        <h1>Terms of Use</h1>
        <p class="muted">
          This Phase 1 placeholder should later define game usage terms, intellectual property
          expectations, limits of liability, and any specific rules covering embedded third-party
          content.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

