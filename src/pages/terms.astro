    margin-bottom: 1rem;
    font-size: 1.5rem;
    color: var(--text);
  }

  .legal-copy h3 {
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    color: var(--text);
  }

  .legal-copy p {
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .legal-copy ul {
    margin-bottom: 1rem;
    padding-left: 2rem;
  }

  .legal-copy li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .legal-copy a {
    color: var(--accent);
    text-decoration: underline;
  }

  .legal-copy a:hover {
    color: var(--accent-hover);
  }
</style>
