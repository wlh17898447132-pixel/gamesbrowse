---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameCard from "../../components/GameCard.astro";
import { getCategoryCatalog, getDiscoverableGames, getGamePixFeedState } from "../../data/games";
import { sanitizeSearchQuery, validateCategory, validateSort } from "../../utils/validation";

const games = getDiscoverableGames();
const categories = getCategoryCatalog();
const gamePixFeedState = getGamePixFeedState();

// Validate URL parameters
const urlParams = Astro.url.searchParams;
const rawQuery = urlParams.get("q") || "";
const rawCategory = urlParams.get("category") || "all";
const rawSort = urlParams.get("sort") || "featured";

const validatedQuery = sanitizeSearchQuery(rawQuery);
const validatedCategory = validateCategory(rawCategory, categories.map(c => c.slug));
const validatedSort = validateSort(rawSort);

const initialGames = games
  .slice()
  .sort((a, b) => {
    if (a.featured !== b.featured) return Number(b.featured) - Number(a.featured);
    if (a.popular !== b.popular) return Number(b.popular) - Number(a.popular);
    if (a.newGame !== b.newGame) return Number(b.newGame) - Number(a.newGame);
    return a.title.localeCompare(b.title);
  });
---
<BaseLayout
  title="All Games - GamesBrowse"
  description="Browse all free online browser games on GamesBrowse, including responsive Playgama and GamePix embeds across arcade, puzzle, racing, reflex, and casual categories."
  canonicalPath="/games/"
>
  <section class="page-section">
    <div class="container stack">
      <div class="hero-panel stack">
        <div class="breadcrumbs">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <span>Games</span>
        </div>
        <span class="eyebrow">All Games</span>
        <h1>Browse All Games</h1>
        <p class="lead">
          Explore the full GamesBrowse catalog, filter by category, and sort by featured picks,
          newest entries, or title.
        </p>
      </div>

      {!gamePixFeedState.available && (
        <div class="panel stack empty-state">
          <h2>Games are temporarily unavailable. Please try again later.</h2>
          <p class="muted">
            The last GamePix feed request did not complete during the build, so some external games
            may be missing from the catalog.
          </p>
        </div>
      )}

      <div class="panel catalog-toolbar stack">
        <div class="catalog-toolbar-grid">
          <label class="form-field">
            <span>Search</span>
            <input
              type="search"
              placeholder="Search games..."
              data-search-input
              aria-label="Search games"
            />
          </label>

          <label class="form-field">
            <span>Category</span>
            <select data-category-filter aria-label="Filter by category">
              <option value="all">All Categories</option>
              {categories.map((category) => (
                <option value={category.slug}>{category.label}</option>
              ))}
            </select>
          </label>

          <label class="form-field">
            <span>Sort</span>
            <select data-sort-select aria-label="Sort games">
              <option value="featured">Featured</option>
              <option value="newest">Newest</option>
              <option value="title">A-Z</option>
            </select>
          </label>
        </div>

        <p class="muted catalog-result-copy">
          <strong data-results-count>{initialGames.length}</strong> games in the current catalog.
        </p>
      </div>

      <div class="game-grid" data-games-grid>
        {initialGames.map((game) => (
          <div
            data-game-item
            data-title={game.title.toLowerCase()}
            data-category={game.categorySlugs.join("|")}
            data-featured={game.featured ? "1" : "0"}
            data-created-at={game.createdAt}
            data-short-description={(game.shortDescription || "").toLowerCase()}
          >
            <GameCard game={game} />
          </div>
        ))}
      </div>

      <div class="panel empty-state" data-empty-state hidden>
        <h2>No games found</h2>
        <p class="muted">Try another keyword or switch back to all categories.</p>
      </div>
    </div>
  </section>

  <script>
    import { initGameCatalog } from '/scripts/game-catalog.js';
    initGameCatalog();
  </script>
</BaseLayout>
