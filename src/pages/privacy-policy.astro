---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Privacy Policy | GamesBrowse"
  description="Privacy policy placeholder for the evolving GamesBrowse site."
  canonicalPath="/privacy-policy/"
>
  <section class="page-section">
    <div class="container">
      <div class="panel legal-copy">
        <span class="eyebrow">Privacy</span>
        <h1>Privacy Policy</h1>
        <p class="muted">
          This page is a Phase 1 placeholder. As analytics, user tracking, and external content
          sources are introduced, this policy should be expanded to document data collection,
          cookies, embed behavior, and third-party services.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

