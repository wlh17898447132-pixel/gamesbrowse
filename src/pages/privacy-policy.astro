---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Privacy Notice | Chaos Front Guide"
  description="Privacy information for the Chaos Front Guide website."
  canonicalPath="/privacy-policy/"
  noindex={true}
>
  <section class="page-section">
    <div class="container">
      <div class="article-copy legal-copy">
        <span class="eyebrow">Privacy</span>
        <h1>Privacy Notice</h1>
        <p class="muted">Last updated: August 14, 2026</p>

        <h2>Site scope</h2>
        <p>
          Chaos Front Guide is a static information site. It does not provide accounts, comments,
          game embeds, newsletters, or a contact form.
        </p>

        <h2>Hosting and technical logs</h2>
        <p>
          The hosting provider may process standard connection data, such as IP address, request
          time, browser information, and requested URL, to deliver and secure the site. This site
          does not intentionally set advertising or analytics cookies.
        </p>

        <h2>Changes</h2>
        <p>This notice will be updated before any analytics, advertising, account, or form feature is introduced.</p>
      </div>
    </div>
  </section>
</BaseLayout>
