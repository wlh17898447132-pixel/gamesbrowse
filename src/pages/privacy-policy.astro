---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Privacy Policy | GamesBrowse"
  description="The full GamesBrowse privacy policy is being finalized."
  canonicalPath="/privacy-policy/"
  noindex={true}
>
  <section class="page-section">
    <div class="container">
      <div class="panel legal-copy">
        <span class="eyebrow">Privacy</span>
        <h1>Privacy Policy</h1>
        <p class="muted">
          This page is a placeholder while the full GamesBrowse privacy policy is prepared. As
          analytics, user tracking, and external content sources are introduced, this policy should
          document data collection, cookies, embed behavior, and third-party services.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

