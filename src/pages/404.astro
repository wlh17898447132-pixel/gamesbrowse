---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Page Not Found | GamesBrowse"
  description="The page you requested could not be found on GamesBrowse."
  canonicalPath={null}
  noindex={true}
>
  <section class="page-section">
    <div class="container center-message">
      <span class="eyebrow">404</span>
      <h1>Page Not Found</h1>
      <p class="muted">The route does not exist in the current GamesBrowse build.</p>
      <div class="button-row">
        <a href="/" class="button button-primary">Go Home</a>
        <a href="/games/" class="button button-secondary">Browse Games</a>
      </div>
    </div>
  </section>
</BaseLayout>
