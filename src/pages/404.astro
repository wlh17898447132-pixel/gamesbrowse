---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Page Not Found | Chaos Front Guide"
  description="The requested page is not available on Chaos Front Guide."
  canonicalPath={null}
  noindex={true}
>
  <section class="page-section">
    <div class="container center-message">
      <span class="eyebrow">404</span>
      <h1>Page Not Found</h1>
      <p class="muted">This route is not part of the current Chaos Front Guide.</p>
      <div class="button-row">
        <a href="/" class="button button-primary">Go Home</a>
        <a href="/about/" class="button button-secondary">About the Guide</a>
      </div>
    </div>
  </section>
</BaseLayout>
