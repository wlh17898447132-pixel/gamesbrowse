---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Contact GamesBrowse"
  description="Contact and licensing information for GamesBrowse is being prepared."
  canonicalPath="/contact/"
  noindex={true}
>
  <section class="page-section">
    <div class="container">
      <div class="panel legal-copy">
        <span class="eyebrow">Contact</span>
        <h1>Contact</h1>
        <p class="muted">
          This page is reserved for future contact information, embed licensing requests, source
          correction requests, and business inquiries.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

