---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Contact GamesBrowse | Game Portal Support"
  description="Contact GamesBrowse for game source corrections, embed licensing questions, privacy requests, and general site feedback."
  canonicalPath="/contact/"
>
  <section class="page-section">
    <div class="container stack">
      <div class="hero-panel stack">
        <span class="eyebrow">Contact</span>
        <h1>Contact GamesBrowse</h1>
        <p class="lead">
          Reach GamesBrowse for game listing corrections, embed licensing questions, privacy
          requests, and site feedback.
        </p>
      </div>

      <div class="portal-info-grid">
        <section class="panel stack">
          <h2>General Support</h2>
          <p class="muted">
            For broken game embeds, inaccurate game details, category corrections, or feedback about
            the GamesBrowse catalog, email <a href="mailto:support@gamesbrowse.online">support@gamesbrowse.online</a>.
          </p>
        </section>

        <section class="panel stack">
          <h2>Rights and Privacy</h2>
          <p class="muted">
            For privacy requests, contact <a href="mailto:privacy@gamesbrowse.online">privacy@gamesbrowse.online</a>.
            For game ownership, licensing, or takedown questions, contact
            <a href="mailto:legal@gamesbrowse.online">legal@gamesbrowse.online</a>.
          </p>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

