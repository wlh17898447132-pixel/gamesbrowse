---
import BaseLayout from "../layouts/BaseLayout.astro";
import { firstWaveGuides, site } from "../data/site";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.url }
    ]
  }
];
---
<BaseLayout
  title="Chaos Front Guide | Verified Strategy Notes"
  description="A Chaos Front guide desk for reproducible Demo and release testing, dated sources, and practical recovery paths."
  canonicalPath="/"
  structuredData={structuredData}
>
  <section class="page-section page-intro">
    <div class="container">
      <div class="intro-grid">
        <div class="stack intro-copy">
          <span class="eyebrow">Player reference desk</span>
          <h1>Chaos Front Guide</h1>
          <p class="lead">
            A focused guide site for Chaos Front. Published notes are grounded in a named game
            build, repeatable conditions, original captures, and a dated source record.
          </p>
          <div class="button-row">
            <a class="button button-primary" href={site.steamUrl} target="_blank" rel="noreferrer">
              Official Steam Page
            </a>
            <a class="button button-secondary" href="/about/">How We Verify</a>
          </div>
        </div>
        <aside class="publication-note" aria-label="Publication status">
          <span class="kicker">Current publication state</span>
          <p>
            The game guide archive is being prepared. No gameplay recommendation is published
            until it has a reproducible test record.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class="page-section" id="guide-desk">
    <div class="container stack">
      <div class="section-heading">
        <div class="stack">
          <span class="kicker">First wave</span>
          <h2>Guide desk</h2>
          <p class="muted">
            These are the first four research tracks. They will become public guides only after
            each practical conclusion is supported by an evidence record.
          </p>
        </div>
      </div>
      <div class="guide-grid">
        {firstWaveGuides.map((guide) => (
          <article class="guide-card">
            <span class="guide-status">{guide.status}</span>
            <h3>{guide.title}</h3>
            <p>{guide.intent}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section rule-section" id="standards">
    <div class="container stack">
      <div class="section-heading">
        <div class="stack">
          <span class="kicker">Editorial standard</span>
          <h2>What qualifies a guide</h2>
        </div>
      </div>
      <div class="standards-grid">
        <section>
          <h3>Named build</h3>
          <p>Every recommendation identifies the game version and its most recent verification date.</p>
        </section>
        <section>
          <h3>Repeatable test</h3>
          <p>Readers get the route, condition, or decision sequence needed to reproduce the result.</p>
        </section>
        <section>
          <h3>Failure path</h3>
          <p>Each guide documents known risks, counterexamples, and a practical fallback where one exists.</p>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>
