---
import CategoryCard from "../components/CategoryCard.astro";
import GameCard from "../components/GameCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getCategoryCatalog,
  getEditorPickGames,
  getFeaturedGames,
  getGameBySlug,
  getGamePixFeedGames,
  getGamePixFeedState,
  getHomeShowcaseGames,
  getNewGames,
  getPopularGames
} from "../data/games";

const gamePixFeedState = getGamePixFeedState();
const buckshotGame = getGameBySlug("buckshot-roulette");
const heroGames = getHomeShowcaseGames(4);
const gamePixGames = getGamePixFeedGames(12);
const featuredGames = getFeaturedGames(6);
const editorPickGames = getEditorPickGames(4);
const popularGames = getPopularGames(6);
const newGames = getNewGames(6);
const categories = getCategoryCatalog();
const popularCategories = categories.filter((category) => category.gameCount > 0).slice(0, 4);
---
<BaseLayout
  title="GamesBrowse - Play Free Online Browser Games"
  description="Play free online browser games on GamesBrowse with responsive GamePix embeds, clean detail pages, and instant access across desktop and mobile."
  canonicalPath="/"
>
  <section class="page-section page-section-hero">
    <div class="container">
      <div class="hero-panel portal-hero-grid">
        <div class="hero-copy hero-copy-wide">
          <span class="eyebrow">GamesBrowse</span>
          <h1>Play Free Online Games Instantly</h1>
          <p class="lead">
            Discover responsive GamePix and browser games on GamesBrowse. Open a game card, jump
            into the detail page, and start playing without leaving the site.
          </p>
          <div class="button-row">
            {buckshotGame ? (
              <a href={buckshotGame.detailUrl} class="button button-primary">Play Buckshot Roulette</a>
            ) : (
              <a href="/games/" class="button button-primary">Browse Games</a>
            )}
            <a href="/games/" class="button button-secondary">Browse Games</a>
          </div>
        </div>

        <div class="hero-showcase">
          {heroGames.map((game) => <GameCard game={game} variant="compact" />)}
        </div>
      </div>
    </div>
  </section>

  <section class="page-section tight" id="search-games">
    <div class="container">
      <div class="panel search-panel">
        <div class="stack">
          <span class="kicker">Search Games</span>
          <h2>Find a game fast</h2>
          <p class="muted">
            Search by title or jump into a category to keep browsing.
          </p>
        </div>
        <form action="/games/" class="search-form" role="search">
          <label class="sr-only" for="home-search">Search games</label>
          <input id="home-search" name="q" type="search" placeholder="Search games..." />
          <button type="submit" class="button button-primary">Search</button>
        </form>
        <div class="tag-list">
          {categories.map((category) => (
            <a class="tag" href={`/category/${category.slug}/`}>
              {category.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="page-section" id="play-free-games">
    <div class="container stack">
      <div class="section-heading">
        <div class="stack">
          <span class="kicker">GamePix Feed</span>
          <h2>Play Free Online Games</h2>
          <p class="muted">
            Fresh GamePix titles pulled into the GamesBrowse catalog with responsive detail pages
            and embedded play.
          </p>
        </div>
        <a href="/games/" class="button button-secondary">All Games</a>
      </div>

      {gamePixFeedState.available ? (
        <div class="game-grid">
          {gamePixGames.map((game) => <GameCard game={game} />)}
        </div>
      ) : (
        <div class="panel stack empty-state">
          <h2>Games are temporarily unavailable. Please try again later.</h2>
          <p class="muted">
            The GamePix feed did not respond during the last build, so the homepage feed section is
            temporarily empty.
          </p>
        </div>
      )}
    </div>
  </section>

  <section class="page-section" id="featured-games">
    <div class="container stack">
      <div class="section-heading">
        <div class="stack">
          <span class="kicker">Featured Games</span>
          <h2>Featured Picks</h2>
          <p class="muted">Highlighted games from the current GamesBrowse catalog.</p>
        </div>
        <a href="/games/" class="button button-secondary">All Games</a>
      </div>
      <div class="game-grid">
        {featuredGames.map((game) => <GameCard game={game} />)}
      </div>
    </div>
  </section>

  <section class="page-section" id="editors-picks">
    <div class="container stack">
      <div class="section-heading">
        <div class="stack">
          <span class="kicker">Editor&apos;s Picks</span>
          <h2>Editor&apos;s Picks</h2>
          <p class="muted">Curated highlights from the current GamesBrowse catalog.</p>
        </div>
        <a href="/games/?sort=featured" class="button button-secondary">Browse Picks</a>
      </div>
      <div class="game-grid">
        {editorPickGames.map((game) => <GameCard game={game} />)}
      </div>
    </div>
  </section>

  <section class="page-section" id="popular-games">
    <div class="container stack">
      <div class="section-heading">
        <div class="stack">
          <span class="kicker">Popular Games</span>
          <h2>Popular Games</h2>
          <p class="muted">A quick mix of portal favorites, replayable picks, and high-interest demos.</p>
        </div>
        <a href="/games/?sort=featured" class="button button-secondary">Browse Popular</a>
      </div>
      <div class="game-grid">
        {popularGames.map((game) => <GameCard game={game} />)}
      </div>
    </div>
  </section>

  <section class="page-section" id="new-games">
    <div class="container stack">
      <div class="section-heading">
        <div class="stack">
          <span class="kicker">New Games</span>
          <h2>New Games</h2>
          <p class="muted">Latest additions across playable entries and fresh catalog previews.</p>
        </div>
        <a href="/games/?sort=newest" class="button button-secondary">See New Games</a>
      </div>
      <div class="game-grid">
        {newGames.map((game) => <GameCard game={game} />)}
      </div>
    </div>
  </section>

  <section class="page-section" id="categories">
    <div class="container stack">
      <div class="section-heading">
        <div class="stack">
          <span class="kicker">Browse by Category</span>
          <h2>Browse by Category</h2>
          <p class="muted">Arcade, puzzle, racing, reflex, and more, all organized for fast discovery.</p>
        </div>
        <a href="/category/" class="button button-secondary">All Categories</a>
      </div>
      <div class="category-grid">
        {categories.map((category) => <CategoryCard category={category} />)}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container portal-info-grid">
      <section class="panel stack">
        <span class="kicker">About GamesBrowse</span>
        <h2>About GamesBrowse</h2>
        <p class="muted">
          GamesBrowse is a lightweight online game portal for free browser games. You can explore
          arcade, puzzle, racing, reflex, and casual games without installing anything. Our goal is
          to make it easy to find a game, start playing quickly, and discover more games after each
          session.
        </p>
      </section>

      <section class="panel stack">
        <span class="kicker">Popular Categories</span>
        <h2>Popular Categories</h2>
        <p class="muted">
          Start with the categories players usually browse first, then jump into game detail pages
          from there.
        </p>
        <div class="tag-list">
          {popularCategories.map((category) => (
            <a class="tag" href={`/category/${category.slug}/`}>
              {category.label}
            </a>
          ))}
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
