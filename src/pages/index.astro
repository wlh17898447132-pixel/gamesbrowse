---
import BaseLayout from "../layouts/BaseLayout.astro";
import { firstWaveGuides, site } from "../data/site";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: site.url }]
  },
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    name: "Chaos Front official trailer",
    description: "Official trailer footage for Chaos Front, a turn-based space mecha mercenary game.",
    thumbnailUrl: `${site.url}${site.trailerPoster}`,
    contentUrl: `${site.url}${site.trailerUrl}`,
    duration: "PT1M7S"
  }
];
---
<BaseLayout
  title="Chaos Front Guide | Official Intel & Field Notes"
  description="Chaos Front release intel, official trailer footage, and evidence-led field guides for the turn-based space mecha mercenary game."
  canonicalPath="/"
  image={site.shareImage}
  structuredData={structuredData}
>
  <section class="hero" id="briefing">
    <img class="hero-media" src={site.trailerPoster} width="1280" height="720" alt="A green mecha stands in a starship bay above a blue planet in Chaos Front" fetchpriority="high" />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="container hero-content">
      <p class="system-label">CENTERSEA SECTOR / OPEN INTEL</p>
      <h1>CHAOS FRONT</h1>
      <p class="hero-subtitle">Official intel and field notes for a turn-based space mecha mercenary campaign.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/release-date/">View Release Intel</a>
        <a class="button button-ghost" href="#trailer">Watch Official Trailer</a>
      </div>
    </div>
  </section>

  <section class="status-band" aria-label="Current game status">
    <div class="container status-grid">
      <div><span>STATUS</span><strong>Demo available on Steam</strong></div>
      <div><span>PLANNED RELEASE</span><strong>{site.releaseDateLabel}</strong></div>
      <div><span>LAST OFFICIAL CHECK</span><strong>August 14, 2026</strong></div>
      <a href={site.steamUrl} target="_blank" rel="noreferrer">Verify on Steam</a>
    </div>
  </section>

  <section class="page-section briefing-section">
    <div class="container section-layout">
      <div class="section-intro">
        <p class="system-label">MISSION BRIEFING</p>
        <h2>A mercenary war across the Centersea Sector</h2>
        <p>
          Steam describes Chaos Front as a turn-based space mecha mercenary game where you recruit
          pilots and captains, modify units, take contracts, and influence conflicts between major powers.
        </p>
        <a class="text-link" href="/release-date/">Read the release and Demo briefing <span aria-hidden="true">&rarr;</span></a>
      </div>
      <div class="intel-grid" aria-label="Official game systems">
        <article class="intel-card">
          <span class="intel-code">01 / CREW</span>
          <h3>Pilots and captains</h3>
          <p>Official material identifies pilots and captains as recruitable personnel with distinct stories and skills.</p>
        </article>
        <article class="intel-card">
          <span class="intel-code">02 / ARSENAL</span>
          <h3>Space combat units</h3>
          <p>The official page lists spaceships, mecha, artillery, and fighters among the units you can buy and modify.</p>
        </article>
        <article class="intel-card intel-card-media">
          <img src="/media/chaos-front-operations.webp" width="960" height="540" loading="lazy" alt="Two green mecha fighting in space in official Chaos Front footage" />
        </article>
        <article class="intel-card">
          <span class="intel-code">03 / CONTRACTS</span>
          <h3>Mission choices</h3>
          <p>Contracts and faction battles form the starting point for the mission and choice guide once tested evidence is ready.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="page-section dark-section" id="guide-desk">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="system-label">FIELD GUIDE QUEUE</p>
          <h2>Evidence before doctrine</h2>
        </div>
        <p>Each module stays out of Google’s index until its advice has a named build, repeatable condition, source, and failure path.</p>
      </div>
      <div class="guide-grid">
        {firstWaveGuides.map((guide) => (
          <article class="guide-card">
            <div class="guide-card-top"><span>{guide.code}</span><span>{guide.status}</span></div>
            <h3>{guide.title}</h3>
            <p>{guide.intent}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section trailer-section" id="trailer">
    <div class="container media-layout">
      <div class="section-intro">
        <p class="system-label">OFFICIAL FOOTAGE</p>
        <h2>Chaos Front trailer</h2>
        <p>
          Official footage supplied with this site. The guide uses the trailer as presentation media,
          not as evidence for untested strategy claims.
        </p>
        <a class="text-link" href={site.steamUrl} target="_blank" rel="noreferrer">Open the official Steam page <span aria-hidden="true">&rarr;</span></a>
      </div>
      <video class="official-trailer" controls preload="metadata" poster={site.trailerPoster} width="1280" height="720">
        <source src={site.trailerUrl} type="video/mp4" />
        Your browser does not support the official trailer video.
      </video>
    </div>
  </section>

  <section class="page-section source-section">
    <div class="container source-grid">
      <div>
        <p class="system-label">PUBLICATION PROTOCOL</p>
        <h2>What makes a guide publishable</h2>
      </div>
      <ol class="protocol-list">
        <li><span>01</span><p><strong>Identify the build.</strong> Every conclusion names the game version and last verification date.</p></li>
        <li><span>02</span><p><strong>Show the condition.</strong> Tests include reproducible steps, a screenshot, or another first-hand record.</p></li>
        <li><span>03</span><p><strong>Include the failure path.</strong> A useful recommendation states where it breaks and what to try instead.</p></li>
      </ol>
      <p class="source-note">Official game facts checked against the Steam listing on August 14, 2026. <a href={site.steamUrl} target="_blank" rel="noreferrer">Source: Steam</a></p>
    </div>
  </section>
</BaseLayout>
