---
import { site } from "../data/site";

const {
  title = site.title,
  description = site.description,
  canonicalPath = "/",
  image = "/og/default-share.svg",
  type = "website",
  noindex = false
} = Astro.props;

const origin = site.url.endsWith("/") ? site.url : `${site.url}/`;
const toAbsolute = (value) => new URL(value.startsWith("/") ? value.slice(1) : value, origin).toString();
const canonicalUrl = canonicalPath === "/" ? origin : toAbsolute(canonicalPath);
const imageUrl = toAbsolute(image);
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow,max-image-preview:large"} />
<link rel="canonical" href={canonicalUrl} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

