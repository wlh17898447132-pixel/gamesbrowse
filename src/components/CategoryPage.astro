---
import BaseLayout from "../layouts/BaseLayout.astro";
import GameCard from "./GameCard.astro";
import { site } from "../data/site";

const {
  category,
  games = [],
  canonicalPath,
  title,
  description,
  noindex = false
} = Astro.props;

const canonicalUrl = `${site.url}${canonicalPath}`;
const structuredData = noindex
  ? []
  : [
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: site.url
          },
          {
            "@type": "ListItem",
            position: 2,
            name: "Categories",
            item: `${site.url}/category/`
          },
          {
            "@type": "ListItem",
            position: 3,
            name: category.label,
            item: canonicalUrl
          }
        ]
      },
      {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        name: title,
        url: canonicalUrl,
        description,
        isPartOf: {
          "@type": "WebSite",
          name: site.name,
          url: site.url
        }
      },
      ...(games.length > 0
        ? [
            {
              "@context": "https://schema.org",
              "@type": "ItemList",
              itemListElement: games.map((game, index) => ({
                "@type": "ListItem",
                position: index + 1,
                name: game.title,
                url: `${site.url}${game.detailUrl}`
              }))
            }
          ]
        : [])
    ];
---
<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  noindex={noindex}
  structuredData={structuredData}
>
  <section class="page-section">
    <div class="container stack">
      <div class="hero-panel stack">
        <div class="breadcrumbs">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/category/">Categories</a>
          <span aria-hidden="true">/</span>
          <span>{category.label}</span>
        </div>
        <span class="eyebrow">{category.label}</span>
        <h1>{category.label} Games</h1>
        <p class="lead">{description}</p>
        <div class="button-row">
          <a href="/games/" class="button button-primary">Browse All Games</a>
          <a href="/category/" class="button button-secondary">More Categories</a>
        </div>
      </div>

      <div class="page-intro panel stack">
        <h2>Games in {category.label}</h2>
        <p class="muted">{category.description}</p>
      </div>

      {games.length > 0 ? (
        <div class="game-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      ) : (
        <div class="panel empty-state">
          <h2>No games in this category yet</h2>
          <p class="muted">Browse all games to keep exploring the GamesBrowse catalog.</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
