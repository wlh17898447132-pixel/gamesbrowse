---
const { category } = Astro.props;
const href = `/category/${category.slug}/`;
const toneClass = category.tone ? `tone-${category.tone}` : "";
---
<a href={href} class="category-card" aria-label={`Browse ${category.label} games`}>
  <div class={`category-card-cover ${toneClass}`.trim()}>
    <span class="category-card-label">Category</span>
    <strong>{category.label}</strong>
  </div>
  <div class="category-card-body">
    <div class="category-card-heading">
      <h3>{category.label}</h3>
      {category.gameCount > 0 && <span>{category.gameCount} games</span>}
    </div>
    <p class="category-card-description">{category.description}</p>
    <span class="card-link">Explore category</span>
  </div>
</a>
