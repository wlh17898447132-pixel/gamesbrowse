<div class="native-game" data-red-light-challenge>
  <div class="game-topbar">
    <div class="status-pill status-idle" data-status-pill>Ready to Start</div>
    <div class="stats" aria-label="Game stats">
      <div class="stat">
        <div class="stat-label">Time</div>
        <div class="stat-value" data-time-value>0.00s</div>
      </div>
      <div class="stat">
        <div class="stat-label">Best</div>
        <div class="stat-value" data-best-value>--</div>
      </div>
      <div class="stat">
        <div class="stat-label">Progress</div>
        <div class="stat-value" data-progress-value>0%</div>
      </div>
    </div>
  </div>

  <div class="game-area">
    <div class="signal-board" data-signal-board>
      Tap Start to Begin
      <small>Green means move. Red means freeze.</small>
    </div>

    <div class="track-wrap">
      <div class="track-labels">
        <span>Start</span>
        <span>Finish</span>
      </div>
      <div class="track" aria-label="Race track">
        <div class="finish-zone">Finish</div>
        <div class="player" data-player aria-hidden="true"></div>
      </div>
    </div>

    <div class="message-box" data-message-box>
      Hold the button or press the spacebar only when the signal is green.
    </div>

    <div class="controls-row">
      <button type="button" class="game-button primary" data-start-btn>Start Game</button>
      <button type="button" class="game-button secondary" data-restart-btn>Restart</button>
      <button
        type="button"
        class="game-button move-button"
        data-move-btn
        aria-label="Hold to move"
      >
        Hold to Move
      </button>
    </div>

    <div class="subtle-note">
      Desktop: hold <strong>Space</strong>. Mobile: press and hold <strong>Hold to Move</strong>.
    </div>
  </div>
</div>

<script type="module" src="/scripts/games/red-light-challenge.js"></script>

