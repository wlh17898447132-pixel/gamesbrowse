---
import { getGameFrameRatio, getGameIframeSrc } from "../data/games";
const { game } = Astro.props;
const frameShellId = `frame-shell-${game.slug}`;
const frameRatio = getGameFrameRatio(game).replace(":", " / ");
const isLandscape = game.orientation === "landscape";
const frameMaxWidth = game.source === "playgama" ? "1200px" : "960px";
const frameMobileRatio = isLandscape ? frameRatio : "4 / 3";
const frameSrc = getGameIframeSrc(game);
const fallbackHref = frameSrc;
---
<div class="panel inset stack">
  <div class="embed-toolbar">
    <div class="pill-row">
      <span class="pill is-brand">Source: {game.sourceName}</span>
      <span class="pill">{game.licenseType}</span>
    </div>
    {game.allowFullscreen && (
      <button
        type="button"
        class="game-button secondary"
        data-frame-fullscreen={frameShellId}
      >
        Fullscreen
      </button>
    )}
  </div>

  <div
    class="game-frame-shell embed-shell"
    id={frameShellId}
    style={`--frame-ratio: ${frameRatio}; --frame-mobile-ratio: ${frameMobileRatio}; --frame-max-width: ${frameMaxWidth};`}
  >
    {frameSrc ? (
      <>
        <div class="embed-loading" data-frame-loading={frameShellId}>Loading game...</div>
        <iframe
          class="game-frame embed-frame"
          src={frameSrc}
          title={game.title}
          loading="lazy"
          allow={game.iframeAllow || "autoplay; fullscreen"}
          sandbox={game.iframeSandbox}
          scrolling="none"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </>
    ) : (
      <div class="game-frame-placeholder">Game is not available.</div>
    )}
  </div>

  {isLandscape && (
    <p class="embed-tip">Mobile tip: rotate your device to landscape if you want a wider play area.</p>
  )}

  {fallbackHref && (
    <p class="embed-note">
      If the embedded game fails to load, open it in a new tab:
      <a href={fallbackHref} target="_blank" rel="noopener noreferrer"> {game.sourceName}</a>.
    </p>
  )}
</div>

<script>
  import { initGameEmbedFrame, initFullscreenHandler } from '/scripts/game-embed.js';

  const frameShellId = `frame-shell-${document.currentScript?.getAttribute('data-frame-id')}`;
  initGameEmbedFrame(frameShellId);
  initFullscreenHandler();
</script>

<script is:inline define:vars={{ frameShellId }}>
  document.currentScript.setAttribute('data-frame-id', frameShellId.replace('frame-shell-', ''));
</script>

