---
import { getGameFrameRatio, getGameIframeSrc } from "../data/games";
const { game } = Astro.props;
const frameShellId = `frame-shell-${game.slug}`;
const frameRatio = getGameFrameRatio(game).replace(":", " / ");
const frameSrc = getGameIframeSrc(game);
const sourceHref = game.gameDistributionUrl || game.iframeBaseUrl || "";
---
<div class="panel inset stack">
  <div class="embed-toolbar">
    <div class="pill-row">
      <span class="pill is-brand">Source: {game.sourceName}</span>
      <span class="pill">{game.licenseType}</span>
    </div>
    {game.allowFullscreen && (
      <button
        type="button"
        class="game-button secondary"
        data-frame-fullscreen={frameShellId}
      >
        Fullscreen
      </button>
    )}
  </div>

  <div class="game-frame-shell embed-shell" id={frameShellId} style={`--frame-ratio: ${frameRatio};`}>
    {frameSrc ? (
      <iframe
        class="game-frame embed-frame"
        src={frameSrc}
        title={game.title}
        loading="lazy"
        allow={game.iframeAllow || "autoplay; fullscreen"}
        sandbox={game.iframeSandbox}
        scrolling="none"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    ) : (
      <div class="game-frame-placeholder">Game is not available.</div>
    )}
  </div>

  {sourceHref && (
    <p class="embed-note">
      If the embedded game fails to load, open it at the source:
      <a href={sourceHref}> {game.sourceName}</a>.
    </p>
  )}
</div>

<script is:inline>
  document.addEventListener("click", (event) => {
    const trigger = event.target.closest("[data-frame-fullscreen]");
    if (!trigger) return;

    const targetId = trigger.getAttribute("data-frame-fullscreen");
    const shell = document.getElementById(targetId);

    if (shell && shell.requestFullscreen) {
      shell.requestFullscreen();
    }
  });
</script>

