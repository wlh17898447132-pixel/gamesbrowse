---
import "../styles/global.css";
import SEOHead from "../components/SEOHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../data/site";

const {
  title = site.title,
  description = site.description,
  canonicalPath = "/",
  image = "/og/default-share.svg",
  type = "website",
  noindex = false,
  structuredData = []
} = Astro.props;

const origin = site.url.endsWith("/") ? site.url : `${site.url}/`;
const siteStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.name,
    url: site.url,
    description: site.description,
    potentialAction: {
      "@type": "SearchAction",
      target: `${site.url}/games/?q={search_term_string}`,
      "query-input": "required name=search_term_string"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: site.name,
    url: site.url,
    logo: new URL("og/default-share.svg", origin).toString()
  }
];
const pageStructuredData = noindex ? [] : [...siteStructuredData, ...structuredData];
---
<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      image={image}
      type={type}
      noindex={noindex}
    />
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9940066146901105"
      crossorigin="anonymous"
    ></script>
    {pageStructuredData.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}
  </head>
  <body>
    <div class="site-shell">
      <SiteHeader />
      <main class="site-main">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>

